@startuml service_interface

title Service Interface And Facade

' Services.cpp is generated from the build configuration. It is the single
' place which knows the service list and the start/stop order.

left to right direction

skinparam nodesep 10
skinparam ranksep 60

interface IService {
    + {abstract} start() = 0 : bool
    + {abstract} stop() = 0 : void
    + {abstract} process() = 0 : void
}

class Services <<generated>> {
    + {static} startAll() : bool
    + {static} stopAll() : void
    + {static} processAll() : void
    + {static} getList(length : uint8_t&) : const Element*
}

class SettingsService <<singleton>>
class MqttService <<singleton>>
class TopicHandlerService <<singleton>>
class FileMgrService <<singleton>>
class RestService <<singleton>>
class MelodyService <<singleton>>
class TimerService <<singleton>>
class HttpService <<singleton>>
class AudioService <<singleton>>

IService <|.. SettingsService
IService <|.. MqttService
IService <|.. TopicHandlerService
IService <|.. FileMgrService
IService <|.. RestService
IService <|.. MelodyService
IService <|.. TimerService
IService <|.. HttpService
IService <|.. AudioService

Services ..> IService: <<use>>

note top of Services
    Generated by scripts/ into src/Generated/Services.cpp.
    Do not edit manually.

    startAll() starts the services in list order.
    stopAll() stops them in reverse order.
end note

note bottom of AudioService
    Not part of the generated service list.
    Started and stopped on demand by plugins.
end note

@enduml
