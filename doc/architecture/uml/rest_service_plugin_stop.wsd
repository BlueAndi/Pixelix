@startuml rest_service_plugin_stop

title REST Service - Plugin Stop

' UML 2.5.1: a combined fragment with a single operand and a guard is
' "opt", not an "alt" without an else operand.

participant "ConcretePlugin" as plugin
participant "RestService" as restService
participant "HttpService" as httpService

autoactivate on

-> plugin: stop()

    plugin -> restService: abortRequest(restId)

        loop over m_requestQueue, while not found
            opt request.restId == restId
                restService -> restService: Erase the request and\nset isRequestFound = true.
                restService <-- restService
            end opt
        end loop

        opt m_activeRestId == restId

            opt m_activeHttpJobId is valid
                restService -> httpService: abortJob(m_activeHttpJobId)
                restService <-- httpService
            end opt

            restService -> restService: Reset m_activeRestId, m_activeHttpJobId\nand the callback. Set isRequestFound = true.
            restService <-- restService

        end opt

        opt false == isRequestFound
            loop over m_responseQueue, while not found
                opt response.restId == restId
                    restService -> restService: Erase the response and\nset isRequestFound = true.
                    restService <-- restService
                end opt
            end loop
        end opt

    plugin <-- restService

<-- plugin

@enduml
