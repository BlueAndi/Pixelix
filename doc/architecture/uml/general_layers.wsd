@startuml general_layers

title Layering

' A layer may only use the layers below it. There is no upward dependency.

package "Application" as appLayer {
}

package "Service" as serviceLayer {
}

package "HAL" as halLayer {
}

package "General" as generalLayer {

    package "Utilities" as utilLayer {
    }

    package "OS" as osLayer {
    }
}

appLayer ..> serviceLayer: <<use>>
appLayer ...> halLayer: <<use>>

serviceLayer ..> halLayer: <<use>>

serviceLayer ..> generalLayer: <<use>>
halLayer ..> generalLayer: <<use>>

note right of appLayer
    Main business logic: system state machine,
    display manager, plugin manager, button
    handling and the web frontend.
end note

note left of serviceLayer
    Services provide functionality which can be
    used for different purposes by the application.
    They are controlled and used by the application.
end note

note left of halLayer
    The hardware abstraction layer provides access to
    MCU or development board specific peripherals.
end note

note left of generalLayer
    Utilities and OS abstractions, usable by every layer.
end note

@enduml
