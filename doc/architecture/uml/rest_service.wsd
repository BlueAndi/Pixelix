@startuml rest_service

title REST Service

' UML 2.5.1 has no "struct" classifier and an interface declares no
' constructors. A C++ struct is modelled as a class with a stereotype.

interface IService {
    + {abstract} start() = 0 : bool
    + {abstract} stop() = 0 : void
    + {abstract} process() = 0 : void
}

class RestService <<singleton>> {
    + {static} INVALID_REST_ID : constexpr uint32_t
    - m_requestQueue : RequestQueue
    - m_responseQueue : ResponseQueue
    - m_isRunning : bool
    - m_restIdCounter : uint32_t
    - m_activeRestId : uint32_t
    - m_activeHttpJobId : HttpJobId
    - m_activePreProcessCallback : PreProcessCallback
    - m_mutex : Mutex
    + {static} getInstance() : RestService&
    + start() : bool
    + stop() : void
    + process() : void
    + get(url : const String&, preProcessCallback : PreProcessCallback) : uint32_t
    + post(url : const String&, preProcessCallback : PreProcessCallback, payload : const uint8_t* = nullptr, size : size_t = 0U) : uint32_t
    + getResponse(restId : uint32_t, isValidRsp : bool&, payload : PsramJsonDocument&) : bool
    + abortRequest(restId : uint32_t) : void
    - handleHttpResponse(httpRsp : const HttpRsp&) : void
}

note right of RestService
    Decouples a plugin from the HTTP transport.

    A plugin queues a request and receives a restId.
    The service executes **one** request at a time in
    the loop task and stores the parsed response until
    the plugin picks it up.
end note

class RequestQueue <<typedef>> {
    std::vector<Request>
}

class ResponseQueue <<typedef>> {
    std::vector<Response>
}

class PreProcessCallback <<typedef>> {
    std::function<bool(const char*, size_t, PsramJsonDocument&)>
}

class Request <<struct>> {
    + id : RequestId
    + restId : uint32_t
    + preProcessCallback : PreProcessCallback
    + url : String
    + data : payload buffer
}

class Response <<struct>> {
    + restId : uint32_t
    + isRsp : bool
    + jsonDocData : PsramJsonDocument
}

enum RequestId {
    REQUEST_ID_GET
    REQUEST_ID_POST
}

class HttpService <<singleton>> {
    + get(url : const char*, handler : IHttpResponseHandler* = nullptr) : HttpJobId
    + post(url : const char*, payload : const uint8_t*, size : size_t, handler : IHttpResponseHandler* = nullptr) : HttpJobId
    + getResponse(jobId : HttpJobId, response : HttpRsp&) : bool
    + abortJob(jobId : HttpJobId) : void
}

note right of HttpService
    Runs a worker task which performs the blocking
    HTTPClient call, so the loop task is never blocked.
    Supports HTTP and HTTPS.
end note

class ConcretePlugin {
    - m_restId : uint32_t
    - preProcessResponse(payload : const char*, payloadSize : size_t, jsonDoc : PsramJsonDocument&) : bool
}

IService <|.. RestService
IService <|.. HttpService

ConcretePlugin ..> RestService: <<use>>
RestService ..> HttpService: <<use>>

RestService +-- Request
RestService +-- Response
RestService +-- RequestId
RestService +-- RequestQueue
RestService +-- ResponseQueue
RestService +-- PreProcessCallback

Request --> RequestId
Request --> PreProcessCallback
RequestQueue o--> "*" Request
ResponseQueue o--> "*" Response

@enduml
