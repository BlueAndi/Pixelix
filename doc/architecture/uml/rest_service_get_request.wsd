@startuml rest_service_get_request

title REST Service - GET Request

' UML 2.5.1: a combined fragment with a single operand and a guard is
' "opt", not an "alt" without an else operand.

participant "ConcretePlugin" as plugin
participant "RestService" as restService
participant "HttpService" as httpService
participant "HTTP worker task" as worker
participant "Server" as server

autoactivate on

== Queue the request (processTask) ==

-> plugin: process(isConnected)
    plugin -> restService: get(url, preProcessCallback)
        restService -> restService: Put the request into m_requestQueue.
        restService <-- restService
    plugin <-- restService: restId
<-- plugin

== Start the request (loopTask) ==

-> restService: process()

    opt no request in flight and m_requestQueue not empty

        restService -> restService: Take the first request from m_requestQueue\nand store m_activeRestId and the callback.
        restService <-- restService

        restService -> httpService: get(url)
            httpService -> httpService: Put the request into m_requestList.
            httpService <-- httpService
        restService <-- httpService: jobId

    end opt

<-- restService

== Execute the request (HTTP worker task) ==

-> httpService: process()
    opt worker idle and m_requestList not empty
        httpService -> worker: Hand over the request\n(mutex protected).
        httpService <-- worker
    end opt
<-- httpService

worker -> server: HTTP GET

    note over worker, server
        The worker task performs the blocking HTTPClient
        call, so the loop task is never blocked.
    end note

worker <-- server: status code and payload

worker -> worker: Store the response\n(mutex protected).
worker <-- worker

== Deliver the response (loopTask) ==

-> httpService: process()
    opt worker response available
        httpService -> httpService: Move the response into m_responseList.
        httpService <-- httpService
    end opt
<-- httpService

-> restService: process()

    opt request in flight

        restService -> httpService: getResponse(jobId, httpRsp)
        restService <-- httpService: isAvailable

        opt isAvailable

            restService -> restService: handleHttpResponse(httpRsp)

                restService -> plugin: preProcessCallback(payload, size, jsonDoc)
                restService <-- plugin: isValid

                restService -> restService: Put the response into m_responseQueue.
                restService <-- restService

            restService <-- restService

            restService -> restService: Clear m_activeRestId, m_activeHttpJobId\nand the callback.
            restService <-- restService

        end opt

    end opt

<-- restService

== Pick up the response (processTask) ==

-> plugin: process(isConnected)
    plugin -> restService: getResponse(restId, isValidRsp, payload)
        restService -> restService: Take the response from m_responseQueue.
        restService <-- restService
    plugin <-- restService: isAvailable, isValidRsp, payload

    plugin -> plugin: React on the response.
    plugin <-- plugin
<-- plugin

@enduml
