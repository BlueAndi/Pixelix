@startuml topic_handler_service

title Topic Handler Service

' UML 2.5.1: a combined fragment with a single operand and a guard is "opt",
' not an "alt" without an else operand.

participant "PluginMgr" as pluginMgr
participant "ConcretePlugin" as plugin
participant "TopicHandlerService" as topicHandlerService
participant "RestApiTopicHandler" as restApiTopicHandler
participant "MqttApiTopicHandler" as mqttApiTopicHandler
participant "HTTP Server" as httpServer
participant "MQTT Client" as mqttClient

autoactivate on

== Registration of plugin topics ==

-> pluginMgr

loop for every plugin

    note over pluginMgr
        <ENTITY-ID> = "display/plugin/<PLUGIN-ALIAS>"
    end note

    pluginMgr -> topicHandlerService: registerTopics(<DEVICE-ID>, <ENTITY-ID>, plugin)

        topicHandlerService -> plugin: getTopics(topics)
        topicHandlerService <-- plugin: topics

        loop for every plugin topic

            topicHandlerService -> topicHandlerService: Determine the topic name,\nits accessibility and extra parameters.
            topicHandlerService <-- topicHandlerService

            loop for every registered topic handler

                topicHandlerService -> restApiTopicHandler: registerTopic(deviceId, entityId, topic,\naccessibility, extra parameters)

                    note over restApiTopicHandler, httpServer
                        URL: <BASE-URI>/<ENTITY-ID>/<TOPIC>
                    end note

                    restApiTopicHandler -> httpServer: Register the REST URL.
                    restApiTopicHandler <-- httpServer

                topicHandlerService <-- restApiTopicHandler

                topicHandlerService -> mqttApiTopicHandler: registerTopic(deviceId, entityId, topic,\naccessibility, extra parameters)

                    opt topic is readable

                        note over mqttApiTopicHandler, mqttClient
                            path: <DEVICE-ID>/<ENTITY-ID>/<TOPIC>/state
                        end note

                        note over mqttApiTopicHandler
                            A readable topic is published
                            * initially after registration,
                            * after connection establishment and
                            * on change.
                        end note

                        mqttApiTopicHandler -> mqttApiTopicHandler: Store the topic in the publisher queue.
                        mqttApiTopicHandler <-- mqttApiTopicHandler

                    end opt

                    opt topic is writeable

                        note over mqttApiTopicHandler, mqttClient
                            path: <DEVICE-ID>/<ENTITY-ID>/<TOPIC>/set
                        end note

                        mqttApiTopicHandler -> mqttClient: Subscribe the topic path.
                        mqttApiTopicHandler <-- mqttClient

                    end opt

                topicHandlerService <-- mqttApiTopicHandler

            end loop

        end loop

    pluginMgr <-- topicHandlerService
end loop

<-- pluginMgr

== Automatic publishing of a changed readable topic ==

-> topicHandlerService: process()

    opt every 500 ms (ON_CHANGE_PERIOD)

        loop for every readable topic

            topicHandlerService -> plugin: hasTopicChanged(topic)
            topicHandlerService <-- plugin: hasChanged

            opt hasChanged

                loop for every registered topic handler

                    topicHandlerService -> restApiTopicHandler: notify(topic)
                    topicHandlerService <-- restApiTopicHandler

                    topicHandlerService -> mqttApiTopicHandler: notify(topic)

                        mqttApiTopicHandler -> plugin: getTopic(topic, value)
                        mqttApiTopicHandler <-- plugin: topic content

                        mqttApiTopicHandler -> mqttClient: Publish the topic content.
                        mqttApiTopicHandler <-- mqttClient

                    topicHandlerService <-- mqttApiTopicHandler

                end loop

            end opt

        end loop

    end opt

<-- topicHandlerService

@enduml
