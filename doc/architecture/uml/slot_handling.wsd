@startuml slot_handling

title Slot Handling

' UML 2.5.1 behaviour notation inside a state is "entry / action",
' "do / action" and "exit / action".

state "Idle" as idle
idle: do / Find the next slot with an enabled plugin\n(from last active slot + 1 to last active slot).
idle: exit / Select the found slot.

state "FadeIn" as fadeIn
fadeIn: entry / Fade the next plugin in.

state "Active" as active
active: entry / If the slot duration > 0, start the timer.
active: do / Show the plugin.
active: exit / Stop the timer.

state "FadeOut" as fadeOut
fadeOut: do / Fade the previous plugin out.

[*] --> idle: / set the last active slot\nto the last slot in the list

idle --> fadeIn: [slot with an enabled plugin found]

fadeIn --> active: [fade in complete]

active --> fadeOut: [plugin disabled] or\n[plugin removed from slot] /\nselect the next slot with an enabled plugin
active --> fadeOut: [timeout] and\n[next slot contains an enabled plugin] and\n[next slot __is not__ the current slot] /\nselect the next slot
active --> fadeOut: [slot requested by user] and\n[requested slot contains an enabled plugin] and\n[requested slot __is not__ the current slot] /\nselect the requested slot
active --> active: ([timeout] and\n[next slot contains an enabled plugin] and\n[next slot __is the same as__ the current slot]) or\n[slot duration reconfigured]

fadeOut --> idle: [fade out complete] and\n[no slot selected]
fadeOut --> fadeIn: [fade out complete] and\n[slot selected]

note top of active
    If the user configures a slot duration of 0 ms, the timer stays
    disabled and the slot remains active until another condition appears.
end note

@enduml
