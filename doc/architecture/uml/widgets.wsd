@startuml widgets

title Widgets

class YAGfx
class YAGfxCanvas

note left of YAGfxCanvas
    A widget draws itself on the canvas.
end note

abstract class Widget {
    - m_canvas : YAGfxCanvas
    + update(gfx : YAGfx&) : void
    # {abstract} paint(gfx : YAGfx&) = 0 : void
}

note left of Widget
    The base widget provides the common widget
    functionality. It holds the width, height and
    the position inside the parent canvas.
end note

YAGfx <|-- YAGfxCanvas
Widget *--> YAGfxCanvas

class BitmapWidget {
    # paint(gfx : YAGfx&) : void
}

class CanvasWidget {
    # paint(gfx : YAGfx&) : void
}

class LampWidget {
    # paint(gfx : YAGfx&) : void
}

class PixelixLogoWidget {
    # paint(gfx : YAGfx&) : void
}

class ProgressBar {
    # paint(gfx : YAGfx&) : void
}

class TextWidget {
    # paint(gfx : YAGfx&) : void
}

class ScrollContainer {
    # paint(gfx : YAGfx&) : void
}

Widget <|-- BitmapWidget
Widget <|-- CanvasWidget
Widget <|-- LampWidget
Widget <|-- PixelixLogoWidget
Widget <|-- ProgressBar
Widget <|-- TextWidget
Widget <|-- ScrollContainer

YAGfx <|-- CanvasWidget

note bottom of PixelixLogoWidget
    Draws the animated Pixelix logo, which is
    calculated and needs no image file.
end note

note bottom of CanvasWidget
    A canvas widget is a widget and a graphics
    context at the same time, so other widgets
    can be drawn inside it.
end note

note bottom of ScrollContainer
    Scrolls its content horizontally or
    vertically if it does not fit.
end note

@enduml
