@startuml audio_service

title Audio Service

package "AudioService" as audioServicePckg {

    interface IAudioObserver {
        + {abstract} notify(data : int32_t*, size : size_t) = 0 : void
    }

    class AudioDrv <<singleton>> {
        + start() : bool
        + stop() : void
        + registerObserver(observer : IAudioObserver&) : bool
        + unregisterObserver(observer : IAudioObserver&) : void
    }

    class SpectrumAnalyzer
    class AudioToneDetector
    class AudioService <<singleton>>
}

package "HAL / Platform" as halPckg {
    class "I2S (ESP-IDF driver)" as i2sDrv
}

class ConcretePlugin

AudioDrv o--> "0..3" IAudioObserver
IAudioObserver <|.. SpectrumAnalyzer
IAudioObserver <|.. AudioToneDetector

AudioService ..> AudioDrv: <<use>>
AudioService *--> "1" SpectrumAnalyzer
AudioService *--> "2" AudioToneDetector

ConcretePlugin ..> AudioService: <<use>>

AudioDrv ..> i2sDrv: <<use>>

note top of SpectrumAnalyzer
    Provides the frequency spectrum
    by using the FFT algorithm.
end note

note top of AudioToneDetector
    Detects a single tone by using
    the Goertzel algorithm.
end note

note right of ConcretePlugin
    Several plugins may use the audio service.

    Attention: every plugin may reconfigure the
    tone detectors, so they are shared state.
end note

note right of AudioService
    Starts and stops the audio driver and provides
    the spectrum analyzer and the tone detector
    instances to the plugins.
end note

@enduml
