@startuml rest_service_stop

title REST Service - Service Stop

' UML 2.5.1: a combined fragment with a single operand and a guard is
' "opt", not an "alt" without an else operand.

participant "ConcretePlugin" as plugin
participant "RestService" as restService
participant "HttpService" as httpService

autoactivate on

== Stop the service ==

-> restService: stop()

    restService -> httpService: abortJob(m_activeHttpJobId)
    restService <-- httpService

    restService -> restService: Clear m_requestQueue and m_responseQueue.
    restService <-- restService

    restService -> restService: Reset m_activeRestId, m_activeHttpJobId\nand the callback.
    restService <-- restService

    restService -> restService: Destroy the mutex and set m_isRunning = false.
    restService <-- restService

<-- restService

== Plugin behaviour while the service is stopped ==

-> plugin: process(isConnected)

    plugin -> restService: get(url, preProcessCallback)
        opt false == m_isRunning
            note over restService
                No new request is accepted.
            end note
        end opt
    plugin <-- restService: INVALID_REST_ID

    plugin -> restService: getResponse(restId, isValidRsp, payload)
        opt false == m_isRunning
            note over restService
                No response is delivered.
            end note
        end opt
    plugin <-- restService: false

    note over plugin, httpService
        Once getResponse() returned false, the plugin resets its own
        request state and stays in a safe state until the REST service
        is started again.
    end note

<-- plugin

@enduml
