@startuml system

title Reference Hardware (ESP32 DevKitV1)

' Physical things are Nodes and Devices in UML 2.5.1 (section 19), not
' packages and components. A connection between nodes is a CommunicationPath,
' drawn as a plain solid line.

skinparam nodesep 20
skinparam ranksep 35

node "External Power Supply" <<device>> as extPowerSupply

node "Housing" as housing {

    node "PCB" <<device>> as pcb {

        node "Power supply protection" as protection {
            node "Overcurrent protection" <<device>> as ocp
            node "Inverse connection protection" <<device>> as icp
            node "Overvoltage protection" <<device>> as ovp
        }

        node "ESP32 DevKitV1" <<device>> as esp32
    }

    node "LED matrix" <<device>> as ledMatrix
    node "User button" <<device>> as userButton
    node "Reset button" <<device>> as resetButton
    node "Ambient light sensor (LDR)" <<device>> as ldr
    node "DHT11 sensor" <<device>> as dht11
}

extPowerSupply -- ocp: Vcc
ocp -- icp
icp -- ovp
ovp -- esp32: Vcc protected
ovp -- ledMatrix: Vcc protected

esp32 -- ledMatrix: data
esp32 -- userButton: input
esp32 -- resetButton: reset
esp32 -- ldr: brightness control
esp32 -- dht11: temperature\nand humidity

legend bottom
    This is the reference hardware of the original design. PIXELIX
    supports many more boards, see platformio.ini and doc/boards.
endlegend

@enduml
