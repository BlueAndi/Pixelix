@startuml plugin-service-dynamic

title Plugin Concept - Install And Uninstall

' UML 2.5.1: a combined fragment with a single operand and a guard is "opt",
' not an "alt" without an else operand.

participant "Application" as app
participant "PluginMgr" as pluginMgr
participant "PluginFactory" as pluginFactory
participant "DisplayMgr" as displayMgr
participant "ConcretePlugin" as plugin
participant "TopicHandlerService" as topicHandlerService

autoactivate on

== Install a plugin ==

app -> pluginMgr: install(name, slotId, alias)

    pluginMgr -> pluginFactory: createPlugin(name, uid)
    pluginMgr <-- pluginFactory: plugin

    pluginMgr -> pluginMgr: determineAlias(name, alias, plugin)
    pluginMgr <-- pluginMgr: unique alias

    pluginMgr -> displayMgr: installPlugin(plugin, slotId)

    alt empty slot available
        displayMgr -> displayMgr: Add the plugin to the slot.
        displayMgr <-- displayMgr
        displayMgr -> plugin: setSlot(slotInterface)
        displayMgr <-- plugin
        displayMgr -> plugin: start(width, height)
        displayMgr <-- plugin
        displayMgr --> pluginMgr: slot id

        pluginMgr -> topicHandlerService: registerTopics(deviceId, "display/plugin/<alias>", plugin)
            topicHandlerService -> plugin: getTopics(topics)
            topicHandlerService <-- plugin: topics
        pluginMgr <-- topicHandlerService

        pluginMgr --> app: plugin

        opt the application wants the plugin visible
            app -> plugin: enable()
            plugin --> app
        end opt

    else no slot available
        displayMgr --> pluginMgr: invalid slot id
        pluginMgr -> pluginFactory: destroyPlugin(plugin)
        pluginMgr <-- pluginFactory
        pluginMgr --> app: nullptr
    end alt

== Uninstall a plugin ==

app -> pluginMgr: uninstall(plugin)

    pluginMgr -> topicHandlerService: unregisterTopics(deviceId, entityId, plugin, purge)
    pluginMgr <-- topicHandlerService

    pluginMgr -> displayMgr: uninstallPlugin(plugin)
        displayMgr -> plugin: stop()
        displayMgr <-- plugin
        displayMgr -> displayMgr: Remove the plugin from the slot.
        displayMgr <-- displayMgr
        displayMgr -> plugin: setSlot(nullptr)
        displayMgr <-- plugin
    pluginMgr <-- displayMgr

    pluginMgr -> pluginFactory: destroyPlugin(plugin)
    pluginMgr <-- pluginFactory

pluginMgr --> app: isSuccessful

@enduml
