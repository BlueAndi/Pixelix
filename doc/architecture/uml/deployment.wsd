@startuml deployment

title Task Deployment

' UML 2.5.1 (section 19.3.3): a Component is never deployed, only an Artifact is.
' A FreeRTOS task is therefore modelled as an Artifact, deployed by nesting it
' into the ExecutionEnvironment which schedules it.

skinparam nodesep 12
skinparam ranksep 30

legend top right
    <&cog> «task» is a project specific stereotype on Artifact.
    It denotes a FreeRTOS task. The number in brackets is its priority.
endlegend

node "ESP32" <<device>> as esp32 {

    node "Core 0\n(Protocol CPU, PRO_CPU)" <<executionEnvironment>> as proCpu {

        artifact "IDLE0 (0)" <<task>> as idle0Task
        artifact "Tmr Svc (1)" <<task>> as tmrSvcTask
        artifact "mdns (1)" <<task>> as mdnsTask
        artifact "tiT (18)" <<task>> as tiTTask
        artifact "eventTask (20)" <<task>> as eventTask
        artifact "esp_timer (22)" <<task>> as espTimerTask
        artifact "wifi (23)" <<task>> as wifiTask
        artifact "ipc0 (24)" <<task>> as ipc0Task
        artifact "AudioDrvTask (1)" <<task>> as audioDrvTask
    }

    node "Core 1\n(Application CPU, APP_CPU)" <<executionEnvironment>> as appCpu {

        artifact "IDLE1 (0)" <<task>> as idle1Task
        artifact "loopTask (1)" <<task>> as loopTask
        artifact "buttonTask (1)" <<task>> as buttonTask
        artifact "processTask (1)" <<task>> as processTask
        artifact "HttpSrvWork (1)" <<task>> as httpSrvWorkTask
        artifact "async_tcp (3)" <<task>> as asyncTcpTask
        artifact "network_event (19)" <<task>> as networkEventTask
        artifact "arduino_events (24)" <<task>> as arduinoEventsTask
        artifact "ipc1 (24)" <<task>> as ipc1Task
    }

    node "No task affinity" <<executionEnvironment>> as floating {

        artifact "updateTask (4)" <<task>> as updateTask
    }

    note top of proCpu
        Core 0 controls the WiFi, Bluetooth and other
        internal peripherals such as SPI, I2C, ADC, etc.
    end note

    note top of appCpu
        Core 1 is available to the application specific part.
    end note

    note bottom of floating
        Tasks without affinity are not pinned to a core. The
        scheduler decides in every cycle on which core they run.
    end note

    proCpu -[hidden]right- appCpu
    proCpu -[hidden]--- floating
}

@enduml
