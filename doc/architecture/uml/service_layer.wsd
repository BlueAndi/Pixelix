@startuml service_layer

title Service Layer

' Every component in the "Services" package realizes IService.
' The lifecycle itself is shown in service_lifecycle.wsd.

skinparam nodesep 20
skinparam ranksep 45

<style>
component {
    .arduino {
        BackGroundColor Lightgreen
    }
    .generated {
        BackGroundColor Orange
    }
}
</style>

package "Service" as servicePckg {

    package "Services\n(all realize IService)" as servicesPckg {

        component "SettingsService" as settingsService
        component "FileMgrService" as fileMgrService
        component "HttpService" as httpService
        component "RestService" as restService
        component "MqttService" as mqttService
        component "MelodyService" as melodyService
        component "TimerService" as timerService
        component "TopicHandlerService" as topicHandlerService
        component "AudioService" as audioService
    }

    package "Topic handling" as topicHandlingPckg {

        interface "ITopicHandler" as iTopicHandler
        component "RestApiTopicHandler" as restApiTopicHandler
        component "MqttApiTopicHandler" as mqttApiTopicHandler
        component "TopicHandlers" <<generated>> as topicHandlers
    }

    package "Graphics" as gfxPckg {

        component "BaseGfx" as baseGfx
        component "YAGfx" as yaGfx
        component "YAWidgets" as yaWidgets
        component "Views" as views
        component "FadeEffects" as fadeEffects
        component "Fonts" as fonts
    }

    package "3rd party" as thirdPartyPckg {

        component "Preferences" <<arduino>> as preferences
        component "FS" <<arduino>> as fs
        component "PubSubClient" as pubSubClient
        component "HTTPClient" <<arduino>> as httpClient
        component "ArduinoFFT" as arduinoFft
    }
}

' --- Topic handling ---

restApiTopicHandler ..|> iTopicHandler
mqttApiTopicHandler ..|> iTopicHandler
topicHandlers ..> restApiTopicHandler: <<use>>
topicHandlers ..> mqttApiTopicHandler: <<use>>
topicHandlerService o-right-> iTopicHandler
mqttApiTopicHandler ..> mqttService: <<use>>

' --- Service collaboration ---

settingsService ..> preferences: <<use>>
fileMgrService ..> fs: <<use>>
fileMgrService ..> topicHandlerService: <<use>>
mqttService ..> pubSubClient: <<use>>
restService ..> httpService: <<use>>
httpService ..> httpClient: <<use>>
audioService ..> arduinoFft: <<use>>
timerService ..> settingsService: <<use>>
mqttService ..> settingsService: <<use>>

' --- Graphics stack ---

yaGfx ..> baseGfx: <<use>>
yaWidgets ..> yaGfx: <<use>>
yaWidgets ..> fonts: <<use>>
views ..> yaWidgets: <<use>>
fadeEffects ..> yaGfx: <<use>>

legend bottom
    AudioService is the only service which is not started by the generated
    Services facade. Plugins which need audio start and stop it on demand.
    ----
    The graphics stack is passive. It is used by the display manager
    and by the plugin views.
endlegend

@enduml
