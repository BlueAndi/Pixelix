@startuml plugin_cfg_handling

title Plugin Concept - Configuration Handling

' UML 2.5.1: a combined fragment with a single operand and a guard is "opt",
' not an "alt" without an else operand.

participant "RestApiTopicHandler" as restApiTopicHandler
participant "PluginMgr" as pluginMgr
participant "DisplayMgr" as displayMgr
participant "ConcretePlugin" as plugin
participant "Filesystem" as fs

autoactivate on

== Initial start of the plugin ==

-> pluginMgr: install(<PLUGIN-TYPE>)
    pluginMgr -> displayMgr: installPlugin(<PLUGIN-INSTANCE>)
        displayMgr -> plugin: start()
            plugin -> fs: Read the configuration from <PLUGIN-UID>.json
            plugin <-- fs

            opt read failed
                note over plugin, fs
                    If the configuration is not available or invalid,
                    an initial configuration is written.
                end note
                plugin -> fs: Write the configuration to <PLUGIN-UID>.json
                plugin <-- fs
            end opt

        displayMgr <-- plugin
    pluginMgr <-- displayMgr
<-- pluginMgr

== Read the configuration via REST API ==

-> restApiTopicHandler: GET /rest/api/v1/display/plugin/<PLUGIN-ALIAS>/<PLUGIN-TOPIC>
    note over restApiTopicHandler
        The topic handler could read the configuration from the
        filesystem. This is avoided on purpose: flash access is slow
        and the plugin could hold a configuration in memory which
        differs from the stored one.
    end note
    restApiTopicHandler -> plugin: getTopic(topic, value)
    restApiTopicHandler <-- plugin: configuration as JSON
<-- restApiTopicHandler: configuration as JSON

== Write the configuration via REST API ==

-> restApiTopicHandler: POST /rest/api/v1/display/plugin/<PLUGIN-ALIAS>/<PLUGIN-TOPIC>
    note over plugin
        The configuration is not written to flash here, because
        flash access is slow and this runs in the web server task.
        It is written during plugin processing instead.
    end note
    restApiTopicHandler -> plugin: setTopic(topic, value)
    restApiTopicHandler <-- plugin
<-- restApiTopicHandler

== Store the configuration during processing ==

-> displayMgr: process()
    displayMgr -> plugin: process(isConnected)
        opt configuration marked as changed
            plugin -> fs: Write the configuration to <PLUGIN-UID>.json
            plugin <-- fs
        end opt
    displayMgr <-- plugin
<-- displayMgr

== Stop of the plugin ==

-> pluginMgr: uninstall(<PLUGIN-UID>)
    pluginMgr -> displayMgr: uninstallPlugin(<PLUGIN-UID>)
        displayMgr -> plugin: stop()
            note over plugin, fs
                Don't waste flash space with unused configurations.
            end note
            plugin -> fs: Remove the configuration <PLUGIN-UID>.json
            plugin <-- fs
        displayMgr <-- plugin
    pluginMgr <-- displayMgr
<-- pluginMgr

@enduml
