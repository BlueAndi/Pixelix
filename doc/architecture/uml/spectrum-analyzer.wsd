@startuml spectrum-analyzer

title Spectrum Analyzer

' UML 2.5.1: a combined fragment with a single operand and a guard is "opt".
' Pure phase headings are plain dividers, not fragments.

participant "SoundReactivePlugin" as plugin
participant "AudioService" as audioService
participant "SpectrumAnalyzer" as specAnalyzer
participant "AudioDrv" as audioDrv
participant "I2S" as i2s

autoactivate on

== Start, triggered by the first plugin which needs audio ==

-> audioService: start()

    audioService -> audioDrv: start()

        audioDrv -> audioDrv: Create the audio driver task\n(if not already created).
        audioDrv <-- audioDrv

        note over audioDrv
            The audio driver task is spawned on the other
            ESP32 core for load sharing.
        end note

        audioDrv -> i2s: i2s_driver_install(I2S_NUM_0)

            note over i2s
                * Port: I2S_NUM_0
                * Sample rate: 14080 Hz
                * Bits per sample: 32
                * Samples per FFT run: 512
                * DMA block size: 256 byte (64 samples)
                * DMA blocks: 4
                * Triggered by the I2S_EVENT_RX_DONE event
            end note

        audioDrv <-- i2s

        audioDrv -> i2s: i2s_set_pin(pinConfig)
        audioDrv <-- i2s

    audioService <-- audioDrv

    audioService -> audioDrv: registerObserver(spectrumAnalyzer)
    audioService <-- audioDrv

<-- audioService

== Audio driver task, triggered by I2S_EVENT_RX_DONE ==

audioDrv <<- i2s: I2S_EVENT_RX_DONE

    loop for every sample of one DMA block (64)
        audioDrv -> i2s: i2s_read(sample)
        audioDrv <-- i2s: sample value
        audioDrv -> audioDrv: Shift the sample and store it\nin the sample buffer.
        audioDrv <-- audioDrv
    end loop

    opt sample buffer full (after 8 DMA blocks)

        loop for every registered observer
            audioDrv -> specAnalyzer: notify(data, size)
                specAnalyzer -> specAnalyzer: calculateFFT()
                specAnalyzer <-- specAnalyzer
                specAnalyzer -> specAnalyzer: copyFreqBins() and set the ready flag.
                specAnalyzer <-- specAnalyzer
            audioDrv <-- specAnalyzer
        end loop

    end opt

== Plugin processing ==

-> plugin: process(isConnected)

    plugin -> audioService: getSpectrumAnalyzer()
    plugin <-- audioService: spectrumAnalyzer

    plugin -> specAnalyzer: areFreqBinsReady()
    plugin <-- specAnalyzer: isReady

    opt isReady

        plugin -> specAnalyzer: getFreqBins(freqBins, len)
        plugin <-- specAnalyzer: frequency bins (by copy)

        plugin -> plugin: Post-processing and drawing.
        plugin <-- plugin

    end opt

<-- plugin

@enduml
