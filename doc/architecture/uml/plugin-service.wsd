@startuml plugin-service

title Plugin Concept - Static View

skinparam nodesep 25
skinparam ranksep 50

interface IPluginMaintenance {
    .. Identity ..
    + {abstract} getName() const = 0 : const char*
    + {abstract} getUID() const = 0 : uint16_t
    + {abstract} setAlias(alias : const String&) = 0 : void
    + {abstract} getAlias() const = 0 : String
    .. Lifecycle ..
    + {abstract} start(width : uint16_t, height : uint16_t) = 0 : void
    + {abstract} process(isConnected : bool) = 0 : void
    + {abstract} stop() = 0 : void
    .. Scheduling ..
    + {abstract} setSlot(slotInterf : const ISlotPlugin*) = 0 : void
    + {abstract} enable() = 0 : void
    + {abstract} disable() = 0 : void
    + {abstract} isEnabled() const = 0 : bool
    + {abstract} active(gfx : YAGfx&) = 0 : void
    + {abstract} inactive() = 0 : void
    + {abstract} update(gfx : YAGfx&) = 0 : void
    .. Topics ..
    + {abstract} getTopics(topics : JsonArray&) const = 0 : void
    + {abstract} getTopic(topic : const String&, value : JsonObject&) const = 0 : bool
    + {abstract} setTopic(topic : const String&, value : const JsonObjectConst&) = 0 : bool
    + {abstract} hasTopicChanged(topic : const String&) = 0 : bool
    + {abstract} isUploadAccepted(topic : const String&, srcFilename : const String&, dstFilename : String&) = 0 : bool
    .. Appearance ..
    + {abstract} getFontType() const = 0 : Fonts::FontType
    + {abstract} setFontType(fontType : Fonts::FontType) = 0 : void
}

note top of IPluginMaintenance
    The maintenance interface. The display manager uses
    it to schedule and draw the plugin, the topic handler
    service uses it to expose the plugin over REST and MQTT.
end note

class "CreateFunc" as createFunc <<dataType>> {
    {field} function pointer:
    {field} (name : const char*, uid : uint16_t) : IPluginMaintenance*
}

note right of createFunc
    typedef declared inside IPluginMaintenance.
    Every concrete plugin provides a matching
    static create() function.
end note

class Plugin {
    # m_name : String
    # m_uid : uint16_t
    # m_alias : String
    # m_isEnabled : bool
}

note right of Plugin
    Base class which implements every method of the
    maintenance interface except update(). A concrete
    plugin therefore only overrides what it really needs.
end note

class ConcretePlugin {
    + {static} create(name : const char*, uid : uint16_t) : IPluginMaintenance*
    + update(gfx : YAGfx&) : void
}

note bottom of ConcretePlugin
    Each plugin represents its own functionality. While it
    is scheduled by the display manager, it may draw on the
    display.

    The plugin specific interface must be protected against
    concurrent access, because a REST request is handled in
    the web server task.
end note

interface ISlotPlugin {
    + {abstract} getDuration() const = 0 : uint32_t
}

class Slot {
    - m_plugin : IPluginMaintenance*
    - m_duration : uint32_t
    - m_isLocked : bool
    + getDuration() const : uint32_t
    + setDuration(duration : uint32_t) : void
    + lock() : void
    + unlock() : void
}

note bottom of Slot
    Design decision: the slot interface shall only be used
    by the display manager, otherwise the slots would have
    to be protected against concurrent access.
end note

class SlotList

class DisplayMgr <<singleton>> {
    + installPlugin(plugin : IPluginMaintenance*, slotId : uint8_t) : bool
    + uninstallPlugin(plugin : IPluginMaintenance*) : void
    + activatePlugin(plugin : IPluginMaintenance*) : void
    + movePluginToSlot(plugin : IPluginMaintenance*, slotId : uint8_t) : bool
    + setSlotDuration(slotId : uint8_t, duration : uint32_t) : bool
}

note right of DisplayMgr
    The interface is protected against
    concurrent access by different tasks.
end note

class PluginMgr <<singleton>> {
    + install(name : const char*, slotId : uint8_t, alias : const String&) : IPluginMaintenance*
    + uninstall(plugin : IPluginMaintenance*) : bool
    + load() : bool
    + save() : void
    - getEntityId(plugin : const IPluginMaintenance*) const : String
    - registerTopics(deviceId : const String&, plugin : IPluginMaintenance*) : void
}

note left of PluginMgr
    Loads and saves the slot configuration in persistent
    memory. Per slot the plugin name, UID and alias are stored.

    It registers the plugin topics at the topic handler
    service. The entity id is derived from the alias:

        display/plugin/<PLUGIN-ALIAS>
end note

class PluginFactory {
    + createPlugin(name : const char*, uid : uint16_t) : IPluginMaintenance*
    + destroyPlugin(plugin : const IPluginMaintenance*) : void
    + isAliasInUse(alias : const String&, except : const IPluginMaintenance*) const : bool
}

note left of PluginFactory
    All plugin types are registered in the factory
    by the generated PluginList. The plugin manager
    uses the factory to create plugin instances.
end note

class "PluginList" as pluginList <<generated>>

class TopicHandlerService <<singleton>>

' --- Relationships ---

IPluginMaintenance +-- createFunc

IPluginMaintenance <|.. Plugin
Plugin <|-- ConcretePlugin
createFunc <.. ConcretePlugin: <<realize>>

Plugin ..> ISlotPlugin: <<use>>
ISlotPlugin <|.. Slot

DisplayMgr o--> SlotList
SlotList *--> "1..*" Slot
Slot --> IPluginMaintenance
DisplayMgr ..> IPluginMaintenance: <<use>>

PluginMgr o--> PluginFactory
PluginMgr ..> DisplayMgr: <<use>>
PluginMgr ..> TopicHandlerService: <<use>>
PluginFactory o--> "*" IPluginMaintenance
pluginList ..> PluginFactory: <<use>>

@enduml
