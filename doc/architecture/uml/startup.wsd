@startuml startup

title System Startup

start

:Initialize board (HAL);
:Initialize two-wire (I2C);
:Mount filesystem;

if (Board, I2C and filesystem ok?) then (no)
    :Enter ErrorState;
    stop
else (yes)
endif

:Start all services;

if (All services started?) then (no)
    :Enter ErrorState;
    stop
else (yes)
endif

:Initialize clock driver and sensors;
:Prepare plugins (PluginMgr);
:Start display and display manager;
:Load general settings;
:Show startup information on the display;

:Sample the user button state
for the duration of the init timer;

if (User button pressed?) then (yes)

    :Set up WiFi access point (APState);
    :Show the access point SSID on the display;

else (no)

    if (Remote WiFi credentials available?) then (no)

        :Show instructions on the display (IdleState);
        :Wait for manual restart;
        stop

    else (yes)

        repeat
            :Show connection establishment on the display;
            :Connect to the WiFi access point (ConnectingState);
        repeat while (Connection established?) is (no) not (yes)

        :Show the hostname and enable
        slot routing on the display (ConnectedState);

    endif

endif

:Handle all kind of external requests;

stop

@enduml
